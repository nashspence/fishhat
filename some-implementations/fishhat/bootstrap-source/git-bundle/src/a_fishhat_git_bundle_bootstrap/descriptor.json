{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.git-bundle",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-git-bundle-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle": {
        "type": "object",
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "media_type": {
            "const": "application/x-git-bundle"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "digest",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "require_self_contained": {
        "const": true
      }
    },
    "required": [
      "bundle",
      "require_self_contained"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:4c566743cbc721d595196d4e53637e41e27369174b1b214088ea491085d54fee"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:d6dfe1d4026c5a54b8b684b02238c548b62cd00337bea815c3ffc86009a6cd8e"
      }
    }
  },
  "process_schema_digest": "sha256:1bdd99e643a3d37e31e7854ea447d07915097bfd07c9737fce9b039e72e7e847"
}
