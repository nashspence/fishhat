{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.git-bundle",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-git-bundle-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle": {
        "type": "object",
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "media_type": {
            "const": "application/x-git-bundle"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "digest",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "require_self_contained": {
        "const": true
      }
    },
    "required": [
      "bundle",
      "require_self_contained"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:4033275d9f8a4a829ca359f52050e1ee1e2c21e8fb7c5ad76fa964ae73aa1bce"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:ef047f866b78e31e7674b841a859b8821312df382f9da176e49088d1d8d42a84"
      }
    }
  },
  "process_schema_digest": "sha256:be911c0d4dc6760393c11ea5486e203ffe89818e36fb6b038d4c4f06a7928c65"
}
