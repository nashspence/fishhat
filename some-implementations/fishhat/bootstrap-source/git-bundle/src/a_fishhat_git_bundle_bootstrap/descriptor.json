{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.git-bundle",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-git-bundle-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle": {
        "type": "object",
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "media_type": {
            "const": "application/x-git-bundle"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "digest",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "require_self_contained": {
        "const": true
      }
    },
    "required": [
      "bundle",
      "require_self_contained"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:af81532ac8dc30c786b5603d73edbabeb56c3f2a7ede8d765459ff131b533b7c"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:ed33694d77c3739f3ddaac266e95ea3cfa4f53e9608626f4d0b1536a11e17df7"
      }
    }
  },
  "process_schema_digest": "sha256:81490bcbcb838edbbd1e2f1744d9ab2099a33567db8e84070d42af7aafb0bec1"
}
