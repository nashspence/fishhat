{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.git-bundle",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-git-bundle-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle": {
        "type": "object",
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "media_type": {
            "const": "application/x-git-bundle"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "digest",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "require_self_contained": {
        "const": true
      }
    },
    "required": [
      "bundle",
      "require_self_contained"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:5fe17c6b8de9cbdeb5ab3dbd8594612731464647e6c54dc9469df9f5dc3c9aae"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:237a21e5ec5189e266e06c63500804e9cbf396944a4f0b6796a7f7c983c8fc46"
      }
    }
  },
  "process_schema_digest": "sha256:648420595f269a4fee9b0437550233c82999d7852d166d2d5555887cb5390863"
}
