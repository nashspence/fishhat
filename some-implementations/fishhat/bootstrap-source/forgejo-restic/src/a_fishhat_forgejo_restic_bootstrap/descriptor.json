{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.forgejo-restic",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-forgejo-restic-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "credential_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "repository_handle",
      "credential_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "restic_repository_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "snapshot_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "bare_repository_path": {
        "type": "string",
        "minLength": 6,
        "maxLength": 512,
        "allOf": [
          {
            "pattern": "^/[^/]"
          },
          {
            "pattern": "[^/]\\.git(?![\\s\\S])"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f*?\\[\\]{}]"
            }
          }
        ]
      },
      "capture_consistency": {
        "enum": [
          "forgejo-stopped",
          "verified-frozen-export"
        ]
      }
    },
    "required": [
      "restic_repository_id",
      "snapshot_id",
      "bare_repository_path",
      "capture_consistency"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:c8672b23c0a320e48e74191009d49e434d8930b35f61b45fed75bd0803059e42"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:42cd633344dddbdd62c82a077e1dee5fcfb951e31459679fe723c38107a90faa"
      }
    }
  },
  "process_schema_digest": "sha256:21ba253d1c6b06a85c1d44daa67a5a43fc38b047f8daafedd7ccea96c3b63d2f"
}
