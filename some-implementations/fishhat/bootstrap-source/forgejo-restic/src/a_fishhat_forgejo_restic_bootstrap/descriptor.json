{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.forgejo-restic",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-forgejo-restic-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "credential_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "repository_handle",
      "credential_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "restic_repository_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "snapshot_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "bare_repository_path": {
        "type": "string",
        "minLength": 6,
        "maxLength": 512,
        "allOf": [
          {
            "pattern": "^/[^/]"
          },
          {
            "pattern": "[^/]\\.git(?![\\s\\S])"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f*?\\[\\]{}]"
            }
          }
        ]
      },
      "capture_consistency": {
        "enum": [
          "forgejo-stopped",
          "verified-frozen-export"
        ]
      }
    },
    "required": [
      "restic_repository_id",
      "snapshot_id",
      "bare_repository_path",
      "capture_consistency"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:4c566743cbc721d595196d4e53637e41e27369174b1b214088ea491085d54fee"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:d6dfe1d4026c5a54b8b684b02238c548b62cd00337bea815c3ffc86009a6cd8e"
      }
    }
  },
  "process_schema_digest": "sha256:1bdd99e643a3d37e31e7854ea447d07915097bfd07c9737fce9b039e72e7e847"
}
