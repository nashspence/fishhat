{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.forgejo-restic",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-forgejo-restic-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "credential_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "repository_handle",
      "credential_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "restic_repository_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "snapshot_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "bare_repository_path": {
        "type": "string",
        "minLength": 6,
        "maxLength": 512,
        "allOf": [
          {
            "pattern": "^/[^/]"
          },
          {
            "pattern": "[^/]\\.git(?![\\s\\S])"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f*?\\[\\]{}]"
            }
          }
        ]
      },
      "capture_consistency": {
        "enum": [
          "forgejo-stopped",
          "verified-frozen-export"
        ]
      }
    },
    "required": [
      "restic_repository_id",
      "snapshot_id",
      "bare_repository_path",
      "capture_consistency"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:e6d5073973658937e563a3f7a95eccb31476b9aa5bd3f3e4df3c354cf4be792c"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:6d16f0aa9f5566d6f8de16276b9edeeb3eb464303c1c6eb19ef2e9dbd0c1c4b1"
      }
    }
  },
  "process_schema_digest": "sha256:88cd09368b7f1099611f64ed1ac2b35d90aa30894580e9052c23a75bf3cb65e2"
}
