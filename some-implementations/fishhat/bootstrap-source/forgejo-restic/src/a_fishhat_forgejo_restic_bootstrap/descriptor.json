{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.forgejo-restic",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-forgejo-restic-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "credential_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "repository_handle",
      "credential_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "restic_repository_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "snapshot_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "bare_repository_path": {
        "type": "string",
        "minLength": 6,
        "maxLength": 512,
        "allOf": [
          {
            "pattern": "^/[^/]"
          },
          {
            "pattern": "[^/]\\.git(?![\\s\\S])"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f*?\\[\\]{}]"
            }
          }
        ]
      },
      "capture_consistency": {
        "enum": [
          "forgejo-stopped",
          "verified-frozen-export"
        ]
      }
    },
    "required": [
      "restic_repository_id",
      "snapshot_id",
      "bare_repository_path",
      "capture_consistency"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:4033275d9f8a4a829ca359f52050e1ee1e2c21e8fb7c5ad76fa964ae73aa1bce"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:ef047f866b78e31e7674b841a859b8821312df382f9da176e49088d1d8d42a84"
      }
    }
  },
  "process_schema_digest": "sha256:be911c0d4dc6760393c11ea5486e203ffe89818e36fb6b038d4c4f06a7928c65"
}
