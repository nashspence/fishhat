{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.forgejo-restic",
  "roles": [
    "bootstrap-source"
  ],
  "entrypoint": "bin/a-fishhat-forgejo-restic-bootstrap",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "credential_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "repository_handle",
      "credential_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "restic_repository_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "snapshot_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      },
      "bare_repository_path": {
        "type": "string",
        "minLength": 6,
        "maxLength": 512,
        "allOf": [
          {
            "pattern": "^/[^/]"
          },
          {
            "pattern": "[^/]\\.git(?![\\s\\S])"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f*?\\[\\]{}]"
            }
          }
        ]
      },
      "capture_consistency": {
        "enum": [
          "forgejo-stopped",
          "verified-frozen-export"
        ]
      }
    },
    "required": [
      "restic_repository_id",
      "snapshot_id",
      "bare_repository_path",
      "capture_consistency"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "bootstrap-source": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json",
        "digest": "sha256:9b7e562b27efbcf38c58a3db394763b9552f1436668dc77af18cb587a007c424"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/bootstrap-source-adapter.schema.json#/$defs/Response",
        "digest": "sha256:ed33694d77c3739f3ddaac266e95ea3cfa4f53e9608626f4d0b1536a11e17df7"
      }
    }
  },
  "process_schema_digest": "sha256:c09b1f550cc8f464e8e3703c262b49cd4dc2e132550bc3322449edfb045ae17f"
}
