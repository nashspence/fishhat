{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.slurm",
  "roles": [
    "scheduler"
  ],
  "entrypoint": "bin/a-fishhat-slurm-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "cluster": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "partition": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "node": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "target_host": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "worker_script": {
        "type": "string",
        "minLength": 2,
        "maxLength": 4096,
        "pattern": "^/",
        "allOf": [
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f]"
            }
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "/(?![\\s\\S])"
            }
          }
        ],
        "description": "Owner-installed batch bootstrap script; requests cannot choose a script or append native options."
      },
      "cpu_unit": {
        "const": "logical-cpu"
      }
    },
    "required": [
      "cluster",
      "partition",
      "account",
      "node",
      "target_host",
      "worker_script",
      "cpu_unit"
    ],
    "additionalProperties": false,
    "description": "Owner-approved host binding for pure request projection only; configuration does not establish native enforcement, custody, or dispatch authority."
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "scheduler": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/scheduler-adapter.schema.json",
        "digest": "sha256:0c6f395ac03c61238b243027921bb59fd610a9c570814b82b49ef0027d007f2e"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/scheduler-adapter.schema.json#/$defs/Response",
        "digest": "sha256:760f4989de426edd21c9a0b5ee71f5417a3dc65a3702728f0abe2793938cf4dc"
      }
    }
  },
  "process_schema_digest": "sha256:be911c0d4dc6760393c11ea5486e203ffe89818e36fb6b038d4c4f06a7928c65"
}
