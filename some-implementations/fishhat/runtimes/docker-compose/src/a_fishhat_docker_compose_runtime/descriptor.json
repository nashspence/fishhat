{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.docker-compose",
  "roles": [
    "runtime"
  ],
  "entrypoint": "bin/a-fishhat-docker-compose-runtime",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "socket_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "account",
      "project",
      "socket_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "service"
    ],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "allOf": [
            {
              "pattern": "^[^/]"
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
              }
            },
            {
              "not": {
                "pattern": "//"
              }
            },
            {
              "not": {
                "pattern": "[\\\\\\u0000-\\u001f]"
              }
            },
            {
              "not": {
                "pattern": "/(?![\\s\\S])"
              }
            }
          ]
        },
        "minItems": 1,
        "maxItems": 256,
        "uniqueItems": true
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "runtime": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/runtime-adapter.schema.json",
        "digest": "sha256:1742a01c3789720cabd70a5cf9385710c908361fe360e482da28470be235f0fa"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/runtime-adapter.schema.json#/$defs/Response",
        "digest": "sha256:b0baaa671a6144e71b29f1fee0fe37da96f5c1e854d627fd7722376240159987"
      }
    }
  },
  "process_schema_digest": "sha256:1bdd99e643a3d37e31e7854ea447d07915097bfd07c9737fce9b039e72e7e847"
}
