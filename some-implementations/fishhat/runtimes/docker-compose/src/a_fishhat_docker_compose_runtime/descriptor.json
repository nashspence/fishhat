{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.docker-compose",
  "roles": [
    "runtime"
  ],
  "entrypoint": "bin/a-fishhat-docker-compose-runtime",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "socket_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "account",
      "project",
      "socket_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "service"
    ],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "allOf": [
            {
              "pattern": "^[^/]"
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.\\.?(?:/|$)"
              }
            },
            {
              "not": {
                "pattern": "//"
              }
            },
            {
              "not": {
                "pattern": "[\\\\\\u0000-\\u001f]"
              }
            },
            {
              "not": {
                "pattern": "/$"
              }
            }
          ]
        },
        "minItems": 1,
        "maxItems": 256,
        "uniqueItems": true
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  }
}
