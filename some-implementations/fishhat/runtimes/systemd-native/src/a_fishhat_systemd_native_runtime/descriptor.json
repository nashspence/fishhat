{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.systemd-native",
  "roles": [
    "runtime"
  ],
  "entrypoint": "bin/a-fishhat-systemd-native-runtime",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "account"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {
      "executable": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "allOf": [
          {
            "pattern": "^[^/]"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f]"
            }
          },
          {
            "not": {
              "pattern": "/(?![\\s\\S])"
            }
          }
        ]
      }
    },
    "required": [
      "executable"
    ],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1",
  "role_contracts": {
    "runtime": {
      "request": {
        "uri": "https://fishhat.invalid/contracts/runtime-adapter.schema.json",
        "digest": "sha256:0cbe7acd85c21f103e6b4f2a9dfdf32b698b2f3d2c521f7ec2129117bfdbb1f9"
      },
      "response": {
        "uri": "https://fishhat.invalid/contracts/runtime-adapter.schema.json#/$defs/Response",
        "digest": "sha256:b3734d438a0e754073b76b6294be9d338c3eb5daca4f26d05ff4a136f71cde6c"
      }
    }
  },
  "process_schema_digest": "sha256:be911c0d4dc6760393c11ea5486e203ffe89818e36fb6b038d4c4f06a7928c65"
}
