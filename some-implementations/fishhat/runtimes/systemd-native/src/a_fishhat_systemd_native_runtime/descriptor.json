  "id": "fishhat.systemd-native",
  "roles": [
    "runtime"
  ],
  "entrypoint": "bin/a-fishhat-systemd-native-runtime",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "account"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {
      "executable": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "allOf": [
          {
            "pattern": "^[^/]"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|(?![\\s\\S]))"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f]"
            }
          },
          {
            "not": {
              "pattern": "/(?![\\s\\S])"
            }
          }
        ]
      }
    },
    "required": [
      "executable"
    ],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  },
