{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.systemd-native",
  "roles": [
    "runtime"
  ],
  "entrypoint": "bin/a-fishhat-systemd-native-runtime",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "account": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "account"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {
      "executable": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "allOf": [
          {
            "pattern": "^[^/]"
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|$)"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "[\\\\\\u0000-\\u001f]"
            }
          },
          {
            "not": {
              "pattern": "/$"
            }
          }
        ]
      }
    },
    "required": [
      "executable"
    ],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "bundle_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "bundle_handle"
    ],
    "additionalProperties": false
  }
}
