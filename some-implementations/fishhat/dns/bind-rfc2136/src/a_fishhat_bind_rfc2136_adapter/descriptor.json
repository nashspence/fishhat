{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.bind-rfc2136",
  "roles": [
    "dns"
  ],
  "entrypoint": "bin/a-fishhat-bind-rfc2136-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "server_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "zone": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[a-z0-9.-]+\\.$"
          },
          {
            "not": {
              "pattern": "^\\.|\\.\\."
            }
          }
        ]
      },
      "tsig_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "server_handle",
      "zone",
      "tsig_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
