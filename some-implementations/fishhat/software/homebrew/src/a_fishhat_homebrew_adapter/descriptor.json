{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.homebrew",
  "roles": [
    "software"
  ],
  "entrypoint": "bin/a-fishhat-homebrew-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "prefix_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "repository_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "prefix_handle",
      "repository_handle"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "formula": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9@+._/-]*(?![\\s\\S])"
      }
    },
    "required": [
      "formula"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1"
}
