{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.launchd",
  "roles": [
    "service"
  ],
  "entrypoint": "bin/a-fishhat-launchd-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "domain_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "service_scope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "domain_handle",
      "service_scope"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "label"
    ],
    "additionalProperties": false
  }
}
