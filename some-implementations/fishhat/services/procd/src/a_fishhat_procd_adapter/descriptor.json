{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.procd",
  "roles": [
    "service"
  ],
  "entrypoint": "bin/a-fishhat-procd-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "receiver_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "service_scope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "required": [
      "receiver_handle",
      "service_scope"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*(?![\\s\\S])"
      }
    },
    "required": [
      "service"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1"
}
