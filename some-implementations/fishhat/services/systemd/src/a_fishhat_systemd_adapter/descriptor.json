{
  "format": "deployment-ops/adapter/v1",
  "id": "fishhat.systemd",
  "roles": [
    "service"
  ],
  "entrypoint": "bin/a-fishhat-systemd-adapter",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "manager_handle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      },
      "unit_scope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*(?![\\s\\S])"
      }
    },
    "required": [
      "manager_handle",
      "unit_scope"
    ],
    "additionalProperties": false
  },
  "component_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "implemented": [],
  "native_qualified": false,
  "source_schema": {
    "type": "object",
    "properties": {
      "unit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.@-]+\\.(service|timer)(?![\\s\\S])"
      }
    },
    "required": [
      "unit"
    ],
    "additionalProperties": false
  },
  "process_protocol": "fishhat.adapter-process/v1"
}
