    "demo-app-data": {
      "profile": "local-data",
      "resources": [
        "dataset:demo-app-state"
      ],
      "type": "storage"
    }
  },
  "hooks": {
    "capture": {
      "component": "maintenance",
      "datasets": [
        "state"
      ],
      "mode": "read",
      "network": "none",
      "role": "capture",
      "secrets": []
    },
    "health": {
      "component": "web",
      "datasets": [],
      "mode": "read",
      "network": "none",
      "role": "health",
      "secrets": []
    },
    "restore": {
      "component": "maintenance",
      "datasets": [
        "state"
      ],
      "mode": "write",
      "network": "none",
      "role": "restore",
      "secrets": []
    },
    "verify-restore": {
      "component": "maintenance",
      "datasets": [
        "state"
      ],
      "mode": "read",
      "network": "none",
      "role": "verify-restore",
      "secrets": []
    }
  },
  "host_id": "node-a",
  "interfaces": {
    "http": {
      "authentication": "public",
      "compatibility": [
        "http-v1"
      ],
      "component": "web",
      "port": 8080,
      "protocol": "http",
      "readiness_hook": "health"
