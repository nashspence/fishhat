  },
  "secret_catalogue": {
    "entries": {
      "db-password": {
        "value_policy": "replaceable"
      }
    },
    "path": "secrets.yaml",
    "source": {
      "instance": "demo-secrets",
      "source": {},
      "source_schema_digest": "sha256:d746974fa9afd5e951f76f9af38954b0ad7f436f2120dc974da65e5ee39f856f"
