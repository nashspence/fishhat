      "owner": null,
      "readers": [
        "maintenance"
      ],
      "rebuild": null,
      "recovery": "preserve",
      "restore": "restore",
      "verify_rebuild": null,
      "verify_restore": "verify-restore",
      "writers": [
        "database",
        "maintenance"
      ]
    }
  },
  "dependencies": {},
  "domain_id": "a6606aee-cb29-5360-a578-3502f7b0a12a",
  "entrypoint": "app.yaml",
