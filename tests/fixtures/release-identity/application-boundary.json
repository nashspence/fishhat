{
  "account": {
    "device_groups": [],
    "resource_account": "app-demo-app",
    "runtime_instance": "quadlet"
  },
  "app_id": "demo-app",
  "components": {
    "database": {
      "profile": "ordinary-v1",
      "role": "internal"
    },
    "maintenance": {
      "profile": "maintenance-v1",
      "role": "maintenance"
    },
    "web": {
      "profile": "ordinary-v1",
      "role": "primary"
    }
  },
  "datasets": {
    "state": {
      "capture": "capture",
      "custody": "app",
      "grant": "demo-app-data",
