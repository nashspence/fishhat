{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/resources.schema.json",
  "$defs": {
    "HostResources": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "control": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 2,
              "maxLength": 512,
              "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
            },
            "reserve_bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 9007199254740991
            },
            "reserve_inodes": {
              "type": "integer",
              "minimum": 128,
              "maximum": 9007199254740991
            },
            "emergency_file_bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 9007199254740991
            },
            "host_memory_reserve_bytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 9007199254740991
            },
            "instance": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "pool": {
              "$ref": "adapter.schema.json#/$defs/Handle"
            }
          },
          "required": [
            "root",
            "reserve_bytes",
            "reserve_inodes",
            "emergency_file_bytes",
            "host_memory_reserve_bytes",
            "instance",
            "pool"
          ],
          "additionalProperties": false,
          "description": "Control allocation selected through an approved storage instance. Its resolved capacity domain must be independent of every workload pool; distinct input handles do not prove separation."
        },
        "pools": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mount": {
                "type": "string",
                "minLength": 2,
                "maxLength": 512,
                "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
              },
              "allocation_budget_bytes": {
                "type": "integer",
                "minimum": 1048576,
                "maximum": 9007199254740991
              },
              "allocation_budget_inodes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 9007199254740991
              },
              "host_reserve_bytes": {
                "type": "integer",
                "minimum": 1048576,
                "maximum": 9007199254740991
              },
              "host_reserve_inodes": {
                "type": "integer",
                "minimum": 128,
                "maximum": 9007199254740991
              },
              "other_writers_max_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "other_writers_max_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "overcommit": {
                "const": false
              },
              "instance": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "pool": {
                "$ref": "adapter.schema.json#/$defs/Handle"
              }
            },
            "required": [
              "mount",
              "allocation_budget_bytes",
              "allocation_budget_inodes",
              "host_reserve_bytes",
              "host_reserve_inodes",
              "other_writers_max_bytes",
              "other_writers_max_inodes",
              "overcommit",
              "instance",
              "pool"
            ],
            "additionalProperties": false,
            "description": "Logical pool selection and hard allocation budget. Provider locators and native identities belong to the selected storage adapter. Admission joins this selection to an approved PoolIdentity and rejects aliased or overlapping capacity domains."
          },
          "minProperties": 1
        },
        "accounts": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "subject_kind": {
                "enum": [
                  "app",
                  "user",
                  "helper"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
              },
              "login": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "compute": {
                "$ref": "resources.schema.json#/$defs/ComputeEnvelope"
              },
              "storage": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      },
                      "allocation": {
                        "$ref": "adapter.schema.json#/$defs/Handle"
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes",
                      "allocation"
                    ],
                    "additionalProperties": false,
                    "description": "Opaque allocation selected within its approved logical pool. The receiving owner binds exact identity and incarnation before accounting or change; paths alone never authorize access."
                  },
                  "state": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      },
                      "allocation": {
                        "$ref": "adapter.schema.json#/$defs/Handle"
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes",
                      "allocation"
                    ],
                    "additionalProperties": false,
                    "description": "Opaque allocation selected within its approved logical pool. The receiving owner binds exact identity and incarnation before accounting or change; paths alone never authorize access."
                  },
                  "scratch": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      },
                      "allocation": {
                        "$ref": "adapter.schema.json#/$defs/Handle"
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes",
                      "allocation"
                    ],
                    "additionalProperties": false,
                    "description": "Opaque allocation selected within its approved logical pool. The receiving owner binds exact identity and incarnation before accounting or change; paths alone never authorize access."
                  },
                  "logs": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+(?:/(?!(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f]+)*(?![\\s\\S])"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      },
                      "allocation": {
                        "$ref": "adapter.schema.json#/$defs/Handle"
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes",
                      "allocation"
                    ],
                    "additionalProperties": false,
                    "description": "Opaque allocation selected within its approved logical pool. The receiving owner binds exact identity and incarnation before accounting or change; paths alone never authorize access."
                  }
                },
                "required": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ],
                "additionalProperties": false
              },
              "automatic_gc": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "subject_kind",
              "subject",
              "login",
              "compute",
              "storage",
              "automatic_gc",
              "reason"
            ],
            "additionalProperties": false
          },
          "minProperties": 1
        },
        "policy": {
          "type": "object",
          "properties": {
            "max_snapshot_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "scan_interval_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            },
            "warning_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "critical_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "clear_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "max_growth_operations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_gc_objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "max_gc_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "gc_cpu_millis": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000
            },
            "gc_memory_max_bytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 9007199254740991
            },
            "gc_interval_seconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 604800
            },
            "gc_jitter_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "required": [
            "max_snapshot_age_seconds",
            "scan_interval_seconds",
            "warning_percent",
            "critical_percent",
            "clear_percent",
            "max_growth_operations",
            "max_gc_objects",
            "max_gc_seconds",
            "gc_cpu_millis",
            "gc_memory_max_bytes",
            "gc_interval_seconds",
            "gc_jitter_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "control",
        "pools",
        "accounts",
        "policy"
      ],
      "additionalProperties": false,
      "description": "Portable capacity and isolation requirements selecting receiving-owner-approved storage and compute instances. Source cannot enroll adapters or prove enforcement. The receiving owner must resolve provider aliases, verify independent control capacity, native isolation and accounting coverage for the chosen platform/profile, or refuse growth. No filesystem, service manager or provider is selected by this contract."
    },
    "AppRequirements": {
      "type": "object",
      "properties": {
        "minimum_memory_bytes": {
          "type": "integer",
          "minimum": 16777216,
          "maximum": 9007199254740991
        },
        "minimum_cpu_millis": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1024000
        },
        "minimum_tasks": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1048576
        },
        "storage_minimum": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "state": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "scratch": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "logs": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "runtime",
            "state",
            "scratch",
            "logs"
          ],
          "additionalProperties": false
        },
        "logs": {
          "type": "object",
          "properties": {
            "max_file_bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 9007199254740991
            },
            "closed_retention_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000
            },
            "overflow": {
              "const": "bounded-loss-visible"
            }
          },
          "required": [
            "max_file_bytes",
            "closed_retention_seconds",
            "overflow"
          ],
          "additionalProperties": false
        },
        "retention": {
          "$ref": "resources.schema.json#/$defs/RetentionPolicy"
        },
        "automatic_gc": {
          "type": "boolean"
        }
      },
      "required": [
        "minimum_memory_bytes",
        "minimum_cpu_millis",
        "minimum_tasks",
        "storage_minimum",
        "logs",
        "retention",
        "automatic_gc"
      ],
      "additionalProperties": false
    },
    "RetentionPolicy": {
      "type": "object",
      "properties": {
        "prior_releases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Number of locally protected prior releases, ordered by parsed verified_at instant descending and then release_digest descending for equal instants. Equivalent timestamp spellings have identical time order."
        },
        "minimum_prior_age_seconds": {
          "type": "integer",
          "minimum": 86400,
          "maximum": 31536000
        },
        "unused_candidate_grace_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 2592000
        },
        "cold_archive": {
          "enum": [
            "keep-local",
            "verified-independent-archive"
          ]
        }
      },
      "required": [
        "prior_releases",
        "minimum_prior_age_seconds",
        "unused_candidate_grace_seconds",
        "cold_archive"
      ],
      "additionalProperties": false,
      "description": "Retention requirements selected from the accepted application source by its local owner. Inventories and cleanup plans derive from this exact policy. keep-local prohibits cold demotion; an explicit cleanup plan or archive receipt cannot override it. Policy changes require separate owner authorization before new retention decisions are prepared."
    },
    "ComputeEnvelope": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1024000
        },
        "cpu_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "memory_high_bytes": {
          "type": "integer",
          "minimum": 16777216,
          "maximum": 9007199254740991
        },
        "memory_max_bytes": {
          "type": "integer",
          "minimum": 16777216,
          "maximum": 9007199254740991
        },
        "swap_max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tasks_max": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1048576
        },
        "io_weight": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "io_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
              },
              "read_bps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "write_bps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "device_id",
              "read_bps",
              "write_bps"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "tmpfs_max_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 9007199254740991
        },
        "tmpfs_max_inodes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 9007199254740991
        },
        "instance": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "allocation": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        }
      },
      "required": [
        "cpu_millis",
        "cpu_weight",
        "memory_high_bytes",
        "memory_max_bytes",
        "swap_max_bytes",
        "tasks_max",
        "io_weight",
        "io_limits",
        "tmpfs_max_bytes",
        "tmpfs_max_inodes",
        "instance",
        "allocation"
      ],
      "additionalProperties": false,
      "description": "Approved compute instance and opaque allocation selection with required limits. cpu_millis is thousandths of one CPU; weights use a normalized 1..10000 scale within a contention group; memory_high_bytes is the pressure threshold and memory_max_bytes the hard ceiling; task and tmpfs limits cover all workload descendants. A provider must qualify an equivalent mapping and report unsupported limits instead of silently omitting them. These requirements do not choose a native controller or its placement."
    },
    "PoolIdentity": {
      "description": "Receiving-owner-verified pool binding, including the approved executor and scope. handle is opaque to core; incarnation changes when a native object is recreated or restored. capacity_domain is canonical within the receiving authority across adapters and aliases, not an adapter-local name, and must be resolved independently before admission. It identifies capacity that cannot be counted twice. Different input strings do not establish isolation. Native filesystem, mount and quota identifiers remain adapter-owned.",
      "type": "object",
      "properties": {
        "executor": {
          "allOf": [
            {
              "$ref": "adapter.schema.json#/$defs/InstanceReference"
            },
            {
              "properties": {
                "role": {
                  "const": "storage"
                }
              }
            }
          ]
        },
        "handle": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        },
        "incarnation": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        },
        "capacity_domain": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        }
      },
      "required": [
        "executor",
        "handle",
        "incarnation",
        "capacity_domain"
      ],
      "additionalProperties": false
    },
    "StorageIdentity": {
      "description": "Exact allocation binding within a pool. Native project IDs, dataset IDs and paths are private adapter details. The owner must reject a binding that does not match the current approved resource generation, instance, scope or native incarnation. An identity record alone is not a grant or evidence of enforcement.",
      "type": "object",
      "properties": {
        "pool": {
          "$ref": "resources.schema.json#/$defs/PoolIdentity"
        },
        "handle": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        },
        "incarnation": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        }
      },
      "required": [
        "pool",
        "handle",
        "incarnation"
      ],
      "additionalProperties": false
    },
    "ComputeIdentity": {
      "description": "Receiving-owner-verified compute allocation; native controller IDs and placement paths remain adapter-owned. Recreated allocations invalidate earlier incarnation evidence. Missing or unqualified native coverage must remain explicit.",
      "type": "object",
      "properties": {
        "executor": {
          "allOf": [
            {
              "$ref": "adapter.schema.json#/$defs/InstanceReference"
            },
            {
              "properties": {
                "role": {
                  "const": "compute"
                }
              }
            }
          ]
