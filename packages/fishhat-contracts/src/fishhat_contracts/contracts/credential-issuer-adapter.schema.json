{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/credential-issuer-adapter.schema.json",
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "consumer": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "issuer": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        },
        "value_destination": {
          "$ref": "adapter.schema.json#/$defs/ProtectedValueDestination"
        }
      },
      "required": [
        "scope",
        "identity",
        "consumer",
        "lifetime_seconds",
        "issuer",
        "value_destination"
      ],
      "additionalProperties": false,
      "description": "Issue one lease for this identity and consumer through the exact approved credential-issuer binding. Other overlapping leases retain their own identities and validity. Return the exact original value through value_destination under the ProtectedValueHandoff contract. Native mutation outcome and protected delivery status are separate; missing value custody cannot be reported as Operation success."
    },
    "renew": {
      "description": "Renew only the exact selected lease. Its issuer scope must match scope; native renewal requires current owner authority and exact issuer enrollment. A replacement lease is a separate issuance, not an implicit renewal target. Return the exact original value through value_destination under the ProtectedValueHandoff contract. Native mutation outcome and protected delivery status are separate; missing value custody cannot be reported as Operation success.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "lease": {
          "$ref": "adapter.schema.json#/$defs/LeaseReference"
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "value_destination": {
          "$ref": "adapter.schema.json#/$defs/ProtectedValueDestination"
        }
      },
      "required": [
        "scope",
        "lease",
        "lifetime_seconds",
        "value_destination"
      ],
      "additionalProperties": false
    },
    "revoke": {
      "description": "Revoke only the exact selected lease. Its issuer scope must match scope. Repeating or reconciling this identity cannot revoke a replacement or another overlapping lease. Revocation has no lifetime argument.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "lease": {
          "$ref": "adapter.schema.json#/$defs/LeaseReference"
        }
      },
      "required": [
        "scope",
        "lease"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit",
        "binding"
      ],
      "additionalProperties": false,
      "description": "The limit bounds the sum of returned top-level collection entries in leases; nested fields within one entry are not separate records. Other scalar or object output fields are fixed-shape metadata and do not count toward this limit. A continuation is an opaque receiver-issued cursor bound to the exact approved executor, scope, query and one stable native observation snapshot. The receiver verifies those bindings on every continuation. Incomplete coverage requires a non-null cursor different from the request cursor; complete coverage has no continuation. Unknown coverage is not resumable and has no continuation; an unavailable or changed snapshot is explicitly unknown and requires a new scan with cursor null. Known records may accompany unknown coverage, but cannot establish complete absence. These per-page bounds do not limit total collection extent or prove native bounded work. The exact current observer binding is required and independently approved by the receiver. Every lease issuer has role credential-issuer and the same scope and logical instance as that binding. Preserve the complete original issuer identity across configuration, installation and generation changes. A differing historical issuer reference requires an independently approved receiver mapping to this current observer before consumption; matching instance names alone never approve that mapping. Lease handle is the logical identity within that issuer instance and scope; identity, consumer, validity and value_handle cannot redefine an existing lease. Distinct overlapping leases remain separate records. Logical identities occur once across the complete stable snapshot, not merely once per page. Duplicate identities, including conflicting validity or value handles, reject within or across pages. An exact retry of an already accepted request and canonical response is idempotent and does not consume its records again; a changed response to that request rejects. Receivers retain indexed identities and page commitments, so total intake work is linear in accepted page and retry bytes without rescanning history. Native cursor/snapshot authentication and current permission remain receiver duties."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "leases": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/CredentialLease"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "leases"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "issue"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/ValueOutput"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "leases": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "validity": {
                              "const": "valid"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Retain native effects independently of the protected value handoff. Terminal satisfied native effects require exact returned identities and complete metadata; successful owning Operation additionally requires available handoff and independently committed private byte custody. Missing or irrecoverable material never permits mutation redispatch."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "renew"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/ValueOutput"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "leases": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "validity": {
                              "const": "valid"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Retain native effects independently of the protected value handoff. Terminal satisfied native effects require exact returned identities and complete metadata; successful owning Operation additionally requires available handoff and independently committed private byte custody. Missing or irrecoverable material never permits mutation redispatch."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "revoke"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "leases": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "validity": {
                              "const": "revoked"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "coverage": {
                    "const": "incomplete"
                  }
                },
                "required": [
                  "coverage"
                ]
              },
              "then": {
                "properties": {
                  "continuation": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "continuation": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "description": "Observation page under the request limit and exact receiver-owned snapshot. Incomplete pages require an advancing continuation; complete and unknown coverage have no continuation. Unknown is not evidence of complete absence."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Output"
                },
                {
                  "$ref": "#/$defs/ValueOutput"
                }
              ]
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies its original invocation attempt. Recovered output must satisfy the original method result and custody contract, using independently retained invocation bytes. Reconciliation supplies no authority to repeat or correct the mutation."
        }
      ]
    },
    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
