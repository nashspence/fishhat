{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/credential-issuer-adapter.schema.json",
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "consumer": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "issuer": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "identity",
        "consumer",
        "lifetime_seconds",
        "issuer"
      ],
      "additionalProperties": false,
      "description": "Issue one lease for this identity and consumer through the exact approved credential-issuer binding. Other overlapping leases retain their own identities and validity."
    },
    "renew": {
      "description": "Renew only the exact selected lease. Its issuer scope must match scope; native renewal requires current owner authority and exact issuer enrollment. A replacement lease is a separate issuance, not an implicit renewal target.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "lease": {
          "$ref": "adapter.schema.json#/$defs/LeaseReference"
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      },
      "required": [
        "scope",
        "lease",
        "lifetime_seconds"
      ],
      "additionalProperties": false
    },
    "revoke": {
      "description": "Revoke only the exact selected lease. Its issuer scope must match scope. Repeating or reconciling this identity cannot revoke a replacement or another overlapping lease. Revocation has no lifetime argument.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "lease": {
          "$ref": "adapter.schema.json#/$defs/LeaseReference"
        }
      },
      "required": [
        "scope",
        "lease"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "leases": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/CredentialLease"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "leases"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "issue"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "leases": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "validity": {
                              "const": "valid"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "renew"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
