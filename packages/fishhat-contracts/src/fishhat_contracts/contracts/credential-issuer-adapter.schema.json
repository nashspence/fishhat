            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "leases": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "validity": {
                              "const": "valid"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.credential-issuer"
            },
            "method": {
              "const": "revoke"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
