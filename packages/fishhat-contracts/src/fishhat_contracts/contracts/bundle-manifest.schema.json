{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/bundle-manifest.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/secrets/v1"
    },
    "repository": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
        }
      },
      "required": [
        "instance",
        "repository_id",
        "name"
      ],
      "additionalProperties": false
    },
    "catalogue_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "generation": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "repository",
    "catalogue_digest",
    "generation",
    "entries"
  ],
  "additionalProperties": false,
  "description": "Manifest of the complete logical secret entry set, in canonical sorted order. The canonical plaintext USTAR profile permits up to 1048576 bytes per regular member, including this canonical JSON manifest, and up to 33554432 total archive bytes including headers and padding. These byte capacities apply equally to readers and writers; there is no separate entry-count ceiling. Every declared entry must be inspected, and noncanonical members, ordering, headers or trailing data are rejected."
}
