{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/cli-output.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/cli/v1"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the stage named by state succeeded or was accepted without a reported problem. For observed, this means the record was read and validated; the contained task may still be active, failed, unknown or incomplete. Execution labels use the separate owner Operation outcome. A test command must derive its exit status from its test result, not from successful observation of that result."
    },
    "state": {
      "enum": [
        "observed",
        "planned",
        "accepted",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "quarantined",
        "paused",
        "rejected",
        "unknown"
      ],
      "description": "Accepted, running, waiting, succeeded, failed, cancelled and quarantined require an Operation result and exactly match its owner-reported execution state. Observed reports a completed read or non-Operation result without asserting execution success. Planned requires a completed Plan response. Paused describes an interrupted client workflow. Unknown describes uncertainty, never a proved rejection or failure."
    },
    "complete": {
      "type": "boolean",
      "description": "Whether the stage named by state is terminal. For observed or planned, only this observation or plan preparation is complete: an enclosed workflow, test or report has its own outcome, and pagination can still require more responses. For an Operation, terminal does not imply success, rollback, release of holds or completion of a separate recovery operation."
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ],
      "description": "The original request identity, matching both the Operation result and any Delivery reference. Reconnection or uncertainty never supplies a replacement identity."
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "result": {
      "anyOf": [
        {
          "oneOf": [
            {
              "$ref": "records.schema.json#/$defs/Info"
            },
            {
              "$ref": "records.schema.json#/$defs/Plan"
            },
            {
              "$ref": "records.schema.json#/$defs/Operation"
            },
            {
              "$ref": "records.schema.json#/$defs/Workflow"
            },
            {
              "$ref": "records.schema.json#/$defs/Checkpoint"
            },
            {
              "$ref": "backup-result.schema.json#/$defs/BackupResult"
            },
            {
              "$ref": "records.schema.json#/$defs/Release"
            },
            {
              "$ref": "records.schema.json#/$defs/Observation"
            },
            {
              "$ref": "client-records.schema.json#/$defs/Info"
            },
            {
              "$ref": "client-records.schema.json#/$defs/Closeout"
            },
            {
              "$ref": "client-records.schema.json#/$defs/ReceiptExport"
            },
            {
              "$ref": "client-records.schema.json#/$defs/TestRun"
            },
            {
              "$ref": "client-records.schema.json#/$defs/SourceRecovery"
            },
            {
              "$ref": "tracking-records.schema.json#/$defs/ReportingResult"
            },
            {
              "$ref": "records.schema.json#/$defs/OperationPage"
            },
            {
              "$ref": "records.schema.json#/$defs/WorkflowPage"
            },
            {
              "$ref": "records.schema.json#/$defs/ObservationPage"
            },
            {
              "$ref": "records.schema.json#/$defs/EventPage"
            },
            {
              "$ref": "records.schema.json#/$defs/ContentStaging"
            },
            {
              "$ref": "resource-records.schema.json#/$defs/ResourceReport"
            },
            {
              "$ref": "common.schema.json#/$defs/RecordReference"
            },
            {
              "$ref": "common.schema.json#/$defs/RecordChunk"
            },
            {
              "$ref": "owner-history.schema.json#/$defs/OwnerHistoryPage"
            },
            {
              "$ref": "owner-history.schema.json#/$defs/HistoricalRecordPage"
            },
            {
              "$ref": "owner-history.schema.json#/$defs/HistoricalRecordChunk"
            },
            {
              "$ref": "owner-history.schema.json#/$defs/HistoricalContentChunk"
            },
            {
              "$ref": "workflow-recovery.schema.json#/$defs/Abandonment"
            },
            {
              "$ref": "workflow-recovery.schema.json#/$defs/NeverPrepared"
            },
            {
              "$ref": "workflow.schema.json#/$defs/LifecycleResult"
            },
            {
              "$ref": "workflow.schema.json#/$defs/MutationAcknowledgment"
            },
            {
              "$ref": "cancellation.schema.json#/$defs/Receipt"
            },
            {
              "$ref": "cancellation.schema.json#/$defs/Page"
            },
            {
              "$ref": "workflow-transfer-history.schema.json#/$defs/WorkflowTransferRecord"
            },
            {
              "$ref": "workflow-evidence.schema.json#/$defs/CurrentAttestation"
            },
            {
              "$ref": "lifecycle-evidence.schema.json#/$defs/EvidenceReference"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "problem": {
      "anyOf": [
        {
          "$ref": "records.schema.json#/$defs/Problem"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "client-records.schema.json#/$defs/Delivery"
        },
        {
          "type": "null"
        }
      ]
    },
    "tracking": {
      "const": "not-attempted"
    }
  },
  "required": [
    "format",
    "ok",
    "state",
    "complete",
    "request_id",
    "location",
    "result",
    "problem"
  ],
  "additionalProperties": false,
  "description": "Human and machine result envelope. Acceptance, execution progress, terminal outcome, and certainty stay distinct. A successful command response or accepted request is not evidence that requested work has completed. RecordReference and RecordChunk replies use observed and establish only retrieval of that reference or chunk. The caller must verify the complete record before presenting a Plan as reviewed or claiming acceptance, execution or complete workflow inspection.",
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "RecordReference",
                  "RecordChunk",
                  "OwnerHistoryPage",
                  "HistoricalRecordPage",
                  "HistoricalRecordChunk",
                  "HistoricalContentChunk",
                  "WorkflowAbandonment",
                  "WorkflowNeverPrepared",
                  "WorkflowLifecycleResult",
                  "WorkflowMutationAcknowledgment",
                  "OperationCancellationReceipt",
                  "OperationCancellationPage",
                  "WorkflowTransferRecord",
                  "CurrentWorkflowAttestation"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "observed"
          },
          "complete": {
            "const": true
          },
          "ok": {
            "const": true
          },
          "problem": {
            "type": "null"
          }
        }
      }
    }
  ]
}
