{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/publisher-receipt.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/publication/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "repository": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
        }
      },
      "required": [
        "instance",
        "repository_id",
        "name"
      ],
      "additionalProperties": false
    },
    "tag": {
      "const": "secrets-bundle"
    },
    "asset": {
      "const": "secrets.tar.age"
    },
    "catalogue_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "previous": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "release_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "asset_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "ciphertext_digest": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "generation": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            }
          },
          "required": [
            "release_id",
            "asset_id",
            "ciphertext_digest",
            "bytes",
            "generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "current": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ciphertext_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "generation": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "release_id",
        "asset_id",
        "ciphertext_digest",
        "bytes",
        "generation"
      ],
      "additionalProperties": false
    },
    "custodian": {
      "type": "object",
      "properties": {
        "tool": {
          "enum": [
            "host-ops",
            "app-ops"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "epoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "tool",
        "id",
        "epoch"
      ],
      "additionalProperties": false
    },
    "recovery_handle": {
      "$ref": "common.schema.json#/$defs/Handle"
    },
    "state": {
      "enum": [
        "completed",
        "uncertain",
        "recovery-required"
      ]
    },
    "verified_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Time"
        },
        {
          "type": "null"
        }
      ]
    },
    "witness": {
      "type": "object",
      "properties": {
        "format": {
          "const": "deployment-ops/witness/v1"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "owner": {
          "type": "object",
          "properties": {
            "tool": {
              "enum": [
                "host-ops",
                "app-ops"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            "epoch": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            }
          },
          "required": [
            "tool",
            "id",
            "epoch"
          ],
          "additionalProperties": false
        },
        "kind": {
          "enum": [
            "plan",
            "acceptance",
            "effect",
            "hold",
            "drain",
            "binding",
            "checkpoint",
            "publication",
            "transfer",
            "approval"
          ]
        },
        "subject_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "workflow_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "boot_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/Time"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?(?![\\s\\S])"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==(?![\\s\\S])"
        }
      },
      "required": [
        "format",
        "id",
        "owner",
        "kind",
        "subject_digest",
        "workflow_id",
        "generation",
        "state",
        "boot_id",
        "evidence_digests",
        "created_at",
        "key_id",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "repository",
    "tag",
    "asset",
    "catalogue_digest",
    "previous",
    "current",
    "custodian",
    "recovery_handle",
    "state",
    "verified_at",
    "witness"
  ],
  "additionalProperties": false
}
