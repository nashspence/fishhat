{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/readiness.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/readiness/v1"
    },
    "resource": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "domain",
            "host",
            "app",
            "source",
            "dns",
            "recovery",
            "publisher",
            "backend",
            "adapter",
            "interface",
            "dataset",
            "component"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "owner_approval": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "old_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "new_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Source"
      },
      "minItems": 0
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_restore_evidence": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "fence_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 71,
        "maxLength": 71,
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "max_downtime_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "max_data_loss_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_disposition": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_custody_record": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
        "minLength": 1,
        "maxLength": 96
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "case_evidence": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
        "minLength": 1,
        "maxLength": 96
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "not_run",
              "passed",
              "failed",
              "not_applicable"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 71,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "evidence",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_applicable"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "state": {
      "enum": [
        "discovery",
        "blocked",
        "ready",
        "cutting-over",
        "accepted",
        "recovery-required"
      ]
    }
  },
  "required": [
    "format",
    "resource",
    "owner_approval",
    "old_owner",
    "new_owner",
    "source_refs",
    "checkpoint",
    "independent_restore_evidence",
    "fence_evidence",
    "max_downtime_seconds",
    "max_data_loss_seconds",
    "retention_disposition",
    "credential_custody_record",
    "required_cases",
    "case_evidence",
    "state"
  ],
  "additionalProperties": false,
  "description": "A resource-specific migration assessment. Discovery, blocked and recovery-required records can be incomplete. For ready, cutting-over and accepted, the receiving owner independently selects the exact required cases for this resource, profile and stage. Each required case must occur in case_evidence and be passed with verified evidence, or not_applicable with verified evidence, a reason and a separately approved case-specific exemption. A packet cannot remove requirements or approve its own exemptions. The named previous and new owners must differ. For a passed case the independently verified per-case evidence digest must match, and its applicability comes from the current profile. The complete set of checkpoint, independent-restore, credential-custody and fencing fields present must match the receiver’s independently selected and verified material, including every exact fence evidence digest. The receiver verifies the underlying material, source pins, ownership, tolerances and retention, checks freshness and authenticates independent approval of the exact JCS packet digest for the intended resource and state under current exclusion before acting. owner_approval identifies the approving decision and is not a self-authenticating grant. A ready record cannot authorize cutting-over or accepted. A later state requires a freshly approved packet. Checkpoint, restore evidence and credential custody requirements apply according to the independently selected profile; the owner binds their presence, identities and applicability in its approval. Fencing evidence for a cutting-over or accepted packet proves the previous writer is excluded or records a receiver-authenticated proof that no previous writer exists.",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ready",
              "cutting-over",
              "accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "owner_approval": {
            "type": "string"
          },
          "source_refs": {
            "minItems": 1
          },
          "retention_disposition": {
            "type": "string"
          },
          "max_downtime_seconds": {
            "type": "integer"
          },
          "max_data_loss_seconds": {
            "type": "integer"
          },
          "required_cases": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "cutting-over",
              "accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fence_evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
