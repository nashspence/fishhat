{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/install-bundle.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/install-bundle/v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "tool": {
      "const": "domain-ops"
    },
    "source_commit": {
      "$ref": "common.schema.json#/$defs/Commit"
    },
    "platform": {
      "enum": [
        "linux-amd64",
        "linux-arm64",
        "macos-arm64",
        "macos-amd64"
      ]
    },
    "python": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^cpython-3\\.[0-9]+(?![\\s\\S])"
    },
    "native_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lock": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/RelativePath"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "wheels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/RelativePath"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "build_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/RelativePath"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "qualification": {
      "enum": [
        "candidate",
        "qualified"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Digest"
      },
      "minItems": 0,
      "uniqueItems": true,
      "description": "Digests of canonical QualificationEvidence records authenticated under the receiver's independently selected verifier policy. An evidence identifier or producer qualification label alone does not establish native eligibility."
    }
  },
  "required": [
    "format",
    "id",
    "tool",
    "source_commit",
    "platform",
    "python",
    "native_requirements",
    "lock",
    "wheels",
    "build_inputs",
    "qualification",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "const": "qualified"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "QualificationEvidence": {
      "type": "object",
      "description": "A verifier's successful native offline-install qualification. subject_digest covers canonical JSON of this entire bundle manifest excluding only qualification and evidence, including every wheel, lock and build-input identity. The receiver authenticates the verifier and report independently, verifies its content digest, and joins its subject, platform and interpreter. This unsigned data shape cannot authenticate itself.",
      "properties": {
        "format": {
          "const": "fishhat.native-offline-install-evidence/v1"
        },
        "subject_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "platform": {
          "$ref": "#/properties/platform"
        },
        "python": {
          "$ref": "#/properties/python"
        },
        "verifier": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "result": {
          "const": "passed"
        }
      },
      "required": [
        "format",
        "subject_digest",
        "platform",
        "python",
        "verifier",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
