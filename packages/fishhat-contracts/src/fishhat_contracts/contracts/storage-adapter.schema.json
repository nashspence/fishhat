{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/storage-adapter.schema.json",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced byte ceiling for this allocation, not a minimum provisioned size. Zero is a hard zero-sized allocation. A larger backing store does not permit a larger effective ceiling."
        },
        "capacity_inodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced inode ceiling for this allocation, not a minimum provisioned count. Zero permits no inodes."
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": [
              "runtime",
              "state",
              "scratch",
              "logs"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "hard_isolation": {
          "type": "boolean",
          "description": "Whether the exact approved byte and inode ceilings must be enforced for the entire independently verified allocation domain."
        }
      },
      "required": [
        "scope",
        "allocation",
        "capacity_bytes",
        "capacity_inodes",
        "purposes",
        "hard_isolation"
      ],
      "additionalProperties": false,
      "description": "Plan the exact approved allocation identity and enforced byte/inode ceilings. Native granularity or provider rounding that changes either ceiling must be disclosed and separately reviewed; it cannot be silently accepted as extra capacity."
    },
    "allocate": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced byte ceiling for this allocation, not a minimum provisioned size. Zero is a hard zero-sized allocation. A larger backing store does not permit a larger effective ceiling."
        },
        "capacity_inodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced inode ceiling for this allocation, not a minimum provisioned count. Zero permits no inodes."
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": [
              "runtime",
              "state",
              "scratch",
              "logs"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "hard_isolation": {
          "type": "boolean",
          "description": "Whether the exact approved byte and inode ceilings must be enforced for the entire independently verified allocation domain."
        }
      },
      "required": [
        "scope",
        "allocation",
        "capacity_bytes",
        "capacity_inodes",
        "purposes",
        "hard_isolation"
      ],
      "additionalProperties": false,
      "description": "Establish the exact approved enforced byte and inode ceilings on the independently verified allocation. For an existing allocation this updates quotas under current owner resource preconditions and exclusion; it does not recreate, retarget or change its native incarnation. A change of allocation identity requires separate owner approval. Reject unsupported exact enforcement or a reduction that cannot be achieved safely without discarding retained data. The backing store may be larger, but successful effective ceilings must equal the reviewed request, including after reconciliation."
    },
    "retire": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced byte ceiling for this allocation, not a minimum provisioned size. Zero is a hard zero-sized allocation. A larger backing store does not permit a larger effective ceiling."
        },
        "capacity_inodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact owner-approved enforced inode ceiling for this allocation, not a minimum provisioned count. Zero permits no inodes."
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": [
              "runtime",
              "state",
              "scratch",
              "logs"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "hard_isolation": {
          "type": "boolean",
          "description": "Whether the exact approved byte and inode ceilings must be enforced for the entire independently verified allocation domain."
        },
        "native_identity_digest": {
          "$ref": "common.schema.json#/$defs/Digest",
          "description": "Independently verified native allocation incarnation selected by the reviewed retirement. Reuse of the same handle never authorizes retiring a replacement incarnation."
        }
      },
      "required": [
        "scope",
        "allocation",
        "capacity_bytes",
        "capacity_inodes",
        "purposes",
        "hard_isolation",
        "native_identity_digest"
      ],
      "additionalProperties": false,
      "description": "Retire only the exact independently verified allocation incarnation under its current owner preconditions and retained-data rules. native_identity_digest identifies that incarnation. capacity_bytes, capacity_inodes, purposes and hard_isolation identify the reviewed preimage requirements; they do not authorize resizing, retargeting or deleting unrelated data. Successful retirement proves this incarnation absent and returns a Retirement receipt, never an active Allocation or a claim that retired quotas are still enforced."
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false,
      "description": "The limit bounds the sum of returned top-level collection entries in allocations; nested fields within one entry are not separate records. Other scalar or object output fields are fixed-shape metadata and do not count toward this limit. A continuation is an opaque receiver-issued cursor bound to the exact approved executor, scope, query and one stable native observation snapshot. The receiver verifies those bindings on every continuation. Incomplete coverage requires a non-null cursor different from the request cursor; complete coverage has no continuation. Unknown coverage is not resumable and has no continuation; an unavailable or changed snapshot is explicitly unknown and requires a new scan with cursor null. Known records may accompany unknown coverage, but cannot establish complete absence. These per-page bounds do not limit total collection extent or prove native bounded work."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Allocation"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "allocations"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "plan"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "allocate"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "allocations": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "retire"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/RetirementOutput"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "retirement": {
                        "$ref": "#/$defs/Retirement"
                      }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "output": {
                    "properties": {
                      "retirement": {
                        "type": "null"
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal known satisfied retirement requires complete coverage and a committed exact Retirement receipt proving the selected incarnation absent. Pending, rejected, unknown or failed effects return retirement null and retain their uncertainty and holds. Historical reviewed quotas in the receipt do not claim current enforcement."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "coverage": {
                    "const": "incomplete"
                  }
                },
                "required": [
                  "coverage"
                ]
              },
              "then": {
                "properties": {
                  "continuation": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "continuation": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "description": "Observation page under the request limit and exact receiver-owned snapshot. Incomplete pages require an advancing continuation; complete and unknown coverage have no continuation. Unknown is not evidence of complete absence."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Output"
                },
                {
                  "$ref": "#/$defs/RetirementOutput"
                }
              ]
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies its original invocation attempt. Recovered output must satisfy the original method result and custody contract, using independently retained invocation bytes. Reconciliation supplies no authority to repeat or correct the mutation."
        }
      ]
    },
    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "allocate"
            },
            "input": {
              "$ref": "#/$defs/allocate"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.storage"
            },
            "method": {
              "const": "retire"
            },
            "input": {
              "$ref": "#/$defs/retire"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RetainedResult": {
      "description": "Complete durable evidence for one adapter.execute mutation. Retain the exact invocation and full direct or reconciliation response, including method, request digest, coverage, effect identity and typed output. Invocation owner, operation, executor and original request bytes must match the accepted Operation. Reconciliation reconstructs its request from this unchanged invocation and retains its original response method and request digest. Readers apply the same method-specific semantics as direct responses, including successful-output identity and custody; a succeeded Operation requires terminal known satisfied evidence. This record neither authenticates an owner nor grants native authority.",
      "type": "object",
      "properties": {
        "invocation": {
          "allOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Invocation"
            },
            {
              "properties": {
                "request": {
                  "$ref": "#/$defs/MutationRequest"
                }
              }
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "invocation",
        "response"
      ],
      "additionalProperties": false
    },
    "Retirement": {
      "type": "object",
      "properties": {
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "native_identity_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "state": {
          "const": "absent"
        },
        "reviewed": {
          "type": "object",
          "properties": {
            "capacity_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Historical reviewed retirement precondition; not a measurement or current enforcement claim for an absent allocation."
            },
            "capacity_inodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Historical reviewed retirement precondition; not a measurement or current enforcement claim for an absent allocation."
            },
            "purposes": {
              "type": "array",
              "items": {
                "enum": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "description": "Historical reviewed retirement precondition; not a measurement or current enforcement claim for an absent allocation."
            },
            "hard_isolation": {
              "type": "boolean",
              "description": "Historical reviewed retirement precondition; not a measurement or current enforcement claim for an absent allocation."
            }
          },
          "required": [
            "capacity_bytes",
            "capacity_inodes",
            "purposes",
            "hard_isolation"
          ],
          "additionalProperties": false
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/Time"
        }
      },
      "required": [
        "allocation",
        "native_identity_digest",
        "state",
        "reviewed",
        "observed_at"
      ],
      "additionalProperties": false,
      "description": "Durably retained terminal receipt for the exact reviewed native allocation incarnation. The independently verified incarnation is absent; a reused handle cannot substitute a new allocation. Reviewed values are historical preconditions, not live quotas or counters. The receipt grants no authority to discard retained data, remove another incarnation or repeat the retirement."
    },
    "RetirementOutput": {
      "type": "object",
      "properties": {
        "retirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retirement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "retirement"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.storage"
        },
        "method": {
          "const": "plan"
        },
        "input": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.storage"
        },
        "method": {
          "const": "allocate"
        },
        "input": {
          "$ref": "#/$defs/allocate"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.storage"
        },
        "method": {
          "const": "retire"
        },
        "input": {
          "$ref": "#/$defs/retire"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.storage"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.storage"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Mutation request objects are typed planning payloads. Native execution requires the owner-authored adapter Invocation with its exact attempt and accepted executor; a bare role request is not an alternate executable boundary."
}
