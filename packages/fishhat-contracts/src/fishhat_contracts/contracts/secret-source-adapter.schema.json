{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/secret-source-adapter.schema.json",
  "$defs": {
    "resolve": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "entry": {
          "$ref": "common.schema.json#/$defs/Entry"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "consumer": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "entry",
        "version",
        "consumer",
        "binding"
      ],
      "additionalProperties": false,
      "description": "Resolve exactly one entry and immutable version for the named consumer through the independently approved binding. This is an exact lookup, not a listing or latest-version selector. The receiving owner verifies the binding against its enrolled instance before dispatch; output cannot substitute another source, entry or version."
    },
    "retrieve": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "entry": {
          "$ref": "common.schema.json#/$defs/Entry"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "consumer": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "scope",
        "entry",
        "version",
        "consumer"
      ],
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "entry": {
          "$ref": "common.schema.json#/$defs/Entry"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "consumer": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        },
        "candidate": {
          "$ref": "adapter.schema.json#/$defs/Artifact"
        },
        "expected_previous": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/SecretPublicationPredecessor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "entry",
        "version",
        "consumer",
        "binding",
        "candidate",
        "expected_previous"
      ],
      "additionalProperties": false,
      "description": "Publish the exact owner-held protected candidate artifact into the selected approved secret-source binding and entry. Before admission or dispatch, expected predecessor source and entry must match the request and a non-null predecessor must have a different immutable version. Null requires independently verified absence and never disables the comparison. The receiver compares the exact predecessor with current provider state before mutation. The candidate is an immutable encrypted or otherwise protected publication artifact, never plaintext embedded in request JSON. A version label alone is not input custody. Replaying accepted work recovers its original result; it does not admit another publication under an existing immutable version. Publication does not rotate issuer values or confirm consumer adoption."
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/SecretVersion"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "versions"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "resolve"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/ResolveOutput"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "retrieve"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "versions": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "publish"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "versions": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies its original invocation attempt. Recovered output must satisfy the original method result and custody contract, using independently retained invocation bytes. Reconciliation supplies no authority to repeat or correct the mutation."
        }
      ]
    },
    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "retrieve"
            },
            "input": {
              "$ref": "#/$defs/retrieve"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.secret-source"
            },
            "method": {
              "const": "publish"
            },
            "input": {
              "$ref": "#/$defs/publish"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ResolveOutput": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        },
        "version": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/SecretVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "$ref": "adapter.schema.json#/$defs/SecretVersion"
              }
            }
          },
          "else": {
            "properties": {
              "version": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Present returns one exact requested secret identity. Absent is a complete verified absence at this binding; unknown cannot claim absence or supply a value. Present and absent require complete response coverage, unknown requires unknown coverage, and all exact lookups have no continuation. Handles remain protected references and never confer retrieval authority."
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.secret-source"
        },
        "method": {
          "const": "resolve"
        },
        "input": {
          "$ref": "#/$defs/resolve"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.secret-source"
        },
        "method": {
          "const": "retrieve"
        },
        "input": {
          "$ref": "#/$defs/retrieve"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.secret-source"
        },
        "method": {
          "const": "publish"
        },
        "input": {
          "$ref": "#/$defs/publish"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.secret-source"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.secret-source"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Mutation request objects are typed planning payloads. Native execution requires the owner-authored adapter Invocation with its exact attempt and accepted executor; a bare role request is not an alternate executable boundary."
}
