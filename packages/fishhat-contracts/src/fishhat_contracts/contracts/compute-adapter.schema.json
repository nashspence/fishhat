{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/compute-adapter.schema.json",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Limit"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "allocation",
        "limits"
      ],
      "additionalProperties": false,
      "description": "Plan the same finite limit patch as set-limits against the effective allocation envelope. Listed quantity/target pairs change; omitted pairs retain their effective values. Planning does not remove, reset or authorize a limit."
    },
    "set-limits": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Limit"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "allocation",
        "limits"
      ],
      "additionalProperties": false,
      "description": "Apply a patch of the listed quantity/target pairs to this allocation. Omitted pairs retain their existing effective values; omission never removes a controlled limit. V1 admits only explicit finite quantities and has no removal, reset, inherit or unlimited sentinel. Before effects, the executor verifies that the resulting envelope, including retained limits, is supported and internally consistent; for example memory-high cannot exceed memory-max when both are controlled. Unsupported patches reject explicitly. Partial application or unverified preservation remains unresolved and cannot establish success. Successful output confirms exactly the changed pairs, while observe reports the complete effective envelope across pages."
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false,
      "description": "Each newly executed null-cursor invocation starts a fresh snapshot. If its first response was not accepted, a new null-cursor invocation may restart the scan. Replay of an already accepted page reuses the receiving owner's retained exact request and response; it does not ask a fresh adapter process to regenerate the old first page. Only a retained non-null cursor continues the previously selected native snapshot. The limit bounds the sum of returned top-level collection entries in limits, counters; nested fields within one entry are not separate records. Other scalar or object output fields are fixed-shape metadata and do not count toward this limit. A continuation is an opaque receiver-issued cursor bound to the exact approved executor, scope, query and one stable native observation snapshot. The receiver verifies those bindings on every continuation. Incomplete coverage requires a non-null cursor different from the request cursor; complete coverage has no continuation. Unknown coverage is not resumable and has no continuation; an unavailable or changed snapshot is explicitly unknown and requires a new scan with cursor null. Known records may accompany unknown coverage, but cannot establish complete absence. These per-page bounds do not limit total collection extent or prove native bounded work."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "counters": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Counter"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "allocation": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Limit"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "allocation",
        "limits",
        "counters"
      ],
      "additionalProperties": false,
      "description": "Observed quantities for the exact allocation. Successful set-limits and its reconciliation confirm exactly the requested patch quantity/target/value/unit set; extra, missing or changed pairs cannot establish success. Pairs omitted from the patch retain their prior effective values and are not repeated in the successful mutation output. Observe reports all effective controlled limits across its pages, including pairs omitted from the last patch. Observation with no known allocation uses null and empty collections."
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.compute"
            },
            "method": {
              "const": "plan"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "problem": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Problem"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "problem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.compute"
            },
            "method": {
              "const": "set-limits"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            },
            "problem": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "adapter.schema.json#/$defs/Problem"
                    },
                    {
                      "properties": {
                        "retry": {
                          "const": "none"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect",
            "problem"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "allocation": {
                        "type": "string"
                      },
                      "limits": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.compute"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "problem": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Problem"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "problem"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "coverage": {
                    "const": "incomplete"
                  }
                },
                "required": [
                  "coverage"
                ]
              },
              "then": {
                "properties": {
                  "continuation": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "continuation": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "description": "Observation page under the request limit and exact receiver-owned snapshot. Incomplete pages require an advancing continuation; complete and unknown coverage have no continuation. Unknown is not evidence of complete absence."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.compute"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            },
            "problem": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Problem"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect",
            "problem"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies its original invocation attempt. Recovered output must satisfy the original method result and custody contract, using independently retained invocation bytes. Reconciliation supplies no authority to repeat or correct the mutation."
        }
      ]
    },
    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.compute"
            },
            "method": {
              "const": "set-limits"
            },
            "input": {
              "$ref": "#/$defs/set-limits"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Limit": {
      "description": "One explicitly named requirement, unique by quantity and target. cpu-max is thousandths of one CPU (1000 permits one CPU-second per wall-clock second), not cumulative CPU time. Weights are normalized 1..10000 within a contention group and are not hard ceilings. Memory high is the pressure threshold, memory max and swap max are hard ceilings; task/tmpfs bounds cover descendants. I/O rates select an approved opaque logical device/domain target; native locators remain adapter-owned. Unsupported requirements must reject or remain explicitly unresolved, never be silently dropped. V1 admits only finite effective quantities: null, removal, reset, inherit and unlimited values are not supported. Omission from a set-limits patch preserves the existing effective value.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "cpu-max"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "millicpus"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "cpu-weight"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "unit": {
              "const": "weight"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "memory-high"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "memory-max"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "swap-max"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "tasks-max"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "tasks"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "io-weight"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "unit": {
              "const": "weight"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "io-read-rate"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes-per-second"
            },
            "target": {
              "$ref": "adapter.schema.json#/$defs/Handle"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "io-write-rate"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes-per-second"
            },
            "target": {
              "$ref": "adapter.schema.json#/$defs/Handle"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "tmpfs-max-bytes"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "bytes"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "const": "tmpfs-max-inodes"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "const": "inodes"
            },
            "target": {
              "type": "null"
            }
          },
          "required": [
            "quantity",
            "value",
            "unit",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RetainedResult": {
      "description": "Complete durable evidence for one adapter.execute mutation. Retain the exact invocation and full direct or reconciliation response, including method, request digest, coverage, effect identity and typed output. Invocation owner, operation, executor and original request bytes must match the accepted Operation. Reconciliation reconstructs its request from this unchanged invocation and retains its original response method and request digest. Readers apply the same method-specific semantics as direct responses, including successful-output identity and custody; a succeeded Operation requires terminal known satisfied evidence. This record neither authenticates an owner nor grants native authority.",
      "type": "object",
      "properties": {
        "invocation": {
          "allOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Invocation"
            },
            {
              "properties": {
                "request": {
                  "$ref": "#/$defs/MutationRequest"
                }
              }
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "invocation",
        "response"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.compute"
        },
        "method": {
          "const": "plan"
        },
        "input": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.compute"
        },
        "method": {
          "const": "set-limits"
        },
        "input": {
          "$ref": "#/$defs/set-limits"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.compute"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.compute"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Mutation request objects are typed planning payloads. Native execution requires the owner-authored adapter Invocation with its exact attempt and accepted executor; a bare role request is not an alternate executable boundary."
}
