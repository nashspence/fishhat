{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/capture-adapter.schema.json",
  "$defs": {
    "assess": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "dataset": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "procedure_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "dataset",
        "destination",
        "procedure_digest",
        "binding"
      ],
      "additionalProperties": false,
      "description": "The binding identifies the independently approved capture executor for this scope. procedure_digest pins the reviewed procedure, not the data snapshot. Destination handles must resolve only within the approved target scope and retained operation custody."
    },
    "capture": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "dataset": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "procedure_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "dataset",
        "destination",
        "procedure_digest",
        "binding"
      ],
      "additionalProperties": false,
      "description": "The binding identifies the independently approved capture executor for this scope. procedure_digest pins the reviewed procedure, not the data snapshot. Destination handles must resolve only within the approved target scope and retained operation custody."
    },
    "restore": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "dataset": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "procedure_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        },
        "snapshot": {
          "$ref": "adapter.schema.json#/$defs/Snapshot"
        }
      },
      "required": [
        "scope",
        "dataset",
        "destination",
        "procedure_digest",
        "binding",
        "snapshot"
      ],
      "additionalProperties": false,
      "description": "The binding identifies the independently approved capture executor for this scope. procedure_digest pins the reviewed procedure, not the data snapshot. Destination handles must resolve only within the approved target scope and retained operation custody. snapshot is the exact selected input, including its producer and immutable artifact closure; dataset must match snapshot.dataset. Replacing that input changes the request identity and requires a newly reviewed request."
    },
    "verify": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "dataset": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "procedure_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        },
        "snapshot": {
          "$ref": "adapter.schema.json#/$defs/Snapshot"
        }
      },
      "required": [
        "scope",
        "dataset",
        "destination",
        "procedure_digest",
        "binding",
        "snapshot"
      ],
      "additionalProperties": false,
      "description": "The binding identifies the independently approved capture executor for this scope. procedure_digest pins the reviewed procedure, not the data snapshot. Destination handles must resolve only within the approved target scope and retained operation custody. snapshot is the exact selected input, including its producer and immutable artifact closure; dataset must match snapshot.dataset. Replacing that input changes the request identity and requires a newly reviewed request."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Snapshot"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "verification": {
          "enum": [
            "consistent",
            "invalid",
            "unknown"
          ]
        }
      },
      "required": [
        "snapshots",
        "verification"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.capture"
            },
            "method": {
              "const": "assess"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "problem": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Problem"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "problem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.capture"
            },
            "method": {
              "const": "capture"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
