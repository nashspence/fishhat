    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.capture"
            },
            "method": {
              "const": "capture"
            },
            "input": {
              "$ref": "#/$defs/capture"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.capture"
            },
            "method": {
              "const": "restore"
            },
