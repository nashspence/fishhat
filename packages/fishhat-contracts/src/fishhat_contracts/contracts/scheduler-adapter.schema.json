            "problem": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Problem"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "problem"
          ],
          "additionalProperties": false
        },
