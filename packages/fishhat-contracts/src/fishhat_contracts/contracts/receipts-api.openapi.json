{
  "openapi": "3.1.0",
  "info": {
    "title": "Optional domain-ops receipts index",
    "version": "1.0.0",
    "description": "Reports only. No operation execution, permissions or fresh owner-status authority."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18125",
      "description": "Synthetic loopback/tunnel address; qualify actual host port."
    }
  ],
  "security": [
    {
      "IndexToken": []
    }
  ],
  "paths": {
    "/v1/workflows/{workflow_id}/events/{event_id}": {
      "parameters": [
        {
          "name": "workflow_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "operationId": "recordEvent",
        "summary": "Record metadata only; never submit an operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durably recorded index event",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AppendAcknowledgment"
                    },
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ]
                }
              }
            }
          },
          "200": {
            "description": "Identical event already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AppendAcknowledgment"
                    },
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid bounded input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Immutable content or epoch conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "Index quota; operation execution unaffected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Append scope permits an acknowledgement of the exact submitted event. Only a caller with both append and read scope receives the full stored envelope, including on duplicate PUT. A conflicting payload returns 409 without disclosing the retained event or reporter."
      },
      "get": {
        "operationId": "getEvent",
        "responses": {
          "200": {
            "description": "Stored reported event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "404": {
            "description": "Index has no such report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid bounded input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Immutable content or epoch conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "Index quota; operation execution unaffected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows/{workflow_id}/events": {
      "parameters": [
        {
          "name": "workflow_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "after",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Start at zero. To continue, send next_after and store_epoch from the preceding page together. A null next_after ends the traversal."
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        {
          "name": "expected_store_epoch",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Required when after is nonzero. Copy store_epoch from the preceding page. If the store epoch changes, restart from zero."
        }
      ],
      "get": {
        "operationId": "listEvents",
        "responses": {
          "200": {
            "description": "Bounded reported history; not live owner status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT for invalid pagination, including nonzero after without expected_store_epoch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "EPOCH_CHANGED when expected_store_epoch differs from the current store epoch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "Index quota; operation execution unaffected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workflows": {
      "parameters": [
        {
          "name": "after",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Start at zero. To continue, send next_after and store_epoch from the preceding page together. A null next_after ends the traversal."
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        {
          "name": "expected_store_epoch",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Required when after is nonzero. Copy store_epoch from the preceding page. If the store epoch changes, restart from zero."
        }
      ],
      "get": {
        "operationId": "listWorkflows",
        "responses": {
          "200": {
            "description": "Workflow IDs by first receipt; not a task queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowPage"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT for invalid pagination, including nonzero after without expected_store_epoch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "EPOCH_CHANGED when expected_store_epoch differs from the current store epoch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "507": {
            "description": "Index quota; operation execution unaffected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Generic process liveness only",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "IndexToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Event": {
        "$ref": "./tracking-records.schema.json#/$defs/Event"
      },
      "Envelope": {
        "$ref": "./tracking-records.schema.json#/$defs/Envelope"
      },
      "EventPage": {
        "$ref": "./tracking-records.schema.json#/$defs/EventPage"
      },
      "WorkflowPage": {
        "$ref": "./tracking-records.schema.json#/$defs/WorkflowPage"
      },
      "Problem": {
        "$ref": "./tracking-records.schema.json#/$defs/Problem"
      },
      "AppendAcknowledgment": {
        "$ref": "./tracking-records.schema.json#/$defs/AppendAcknowledgment"
      }
    }
  }
}
