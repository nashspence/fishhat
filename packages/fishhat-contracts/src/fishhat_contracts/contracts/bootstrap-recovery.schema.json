{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/bootstrap-recovery.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/bootstrap-selection/v1"
    },
    "purpose": {
      "const": "source-only"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/Entry"
    },
    "ref": {
      "$ref": "common.schema.json#/$defs/GitRef"
    },
    "expected_commit": {
      "$ref": "common.schema.json#/$defs/Commit"
    },
    "adapter": {
      "$ref": "#/$defs/AdapterBinding"
    },
    "capture": {
      "$ref": "adapter.schema.json#/$defs/Artifact"
    },
    "catalogue_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "kit_manifest_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "recovery_root": {
      "$ref": "common.schema.json#/$defs/AbsolutePath"
    },
    "verify_only": {
      "const": true
    },
    "force_checkout": {
      "const": false
    },
    "install_dependencies": {
      "const": false
    },
    "download_tools": {
      "const": false
    },
    "full_service_restore_separate": {
      "const": true
    }
  },
  "required": [
    "format",
    "purpose",
    "domain_id",
    "source_id",
    "ref",
    "expected_commit",
    "adapter",
    "capture",
    "catalogue_digest",
    "kit_manifest_digest",
    "recovery_root",
    "verify_only",
    "force_checkout",
    "install_dependencies",
    "download_tools",
    "full_service_restore_separate"
  ],
  "additionalProperties": false,
  "$defs": {
    "AdapterBinding": {
      "type": "object",
      "properties": {
        "implementation": {
          "$ref": "adapter.schema.json#/$defs/ImplementationId"
        },
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "descriptor_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "configuration_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "source_schema_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "implementation",
        "installation_digest",
        "descriptor_digest",
        "configuration_digest",
        "source_schema_digest"
      ],
      "additionalProperties": false,
      "description": "Offline selection of pinned adapter records. This record grants no execution authority and does not prove artifact authenticity or native qualification. Initial dispatch and reconciliation must join every pin to the actual independently approved bootstrap executor and installed descriptor; approving another instance does not replace this selection. The request repository scope handle equals source_id."
    }
  }
}
