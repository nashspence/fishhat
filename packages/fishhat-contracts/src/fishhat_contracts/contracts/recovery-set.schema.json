{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/recovery-set.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/native-recovery-set/v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "catalogue_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "native_kit_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "installation_bundle_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "platform": {
      "enum": [
        "linux-amd64",
        "linux-arm64",
        "macos-arm64",
        "macos-amd64"
      ]
    },
    "start_record_hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "owner_rescue_digests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Digest"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "application_closure_digests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Digest"
      },
      "minItems": 0,
      "uniqueItems": true,
      "description": "Complete unique closure digests for every independently retained application recovery obligation in the selected domain, including residual obligations for removed applications. Empty is valid exactly when that inventory is empty. Qualification requires independent complete inventory comparison."
    },
    "independent_custody": {
      "type": "boolean"
    },
    "qualified": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Digest"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "installation_bundle_path": {
      "$ref": "common.schema.json#/$defs/AbsolutePath"
    }
  },
  "required": [
    "format",
    "id",
    "domain_id",
    "catalogue_digest",
    "native_kit_digest",
    "installation_bundle_digest",
    "platform",
    "installation_bundle_path",
    "start_record_hint",
    "owner_rescue_digests",
    "application_closure_digests",
    "independent_custody",
    "qualified",
    "evidence"
  ],
  "additionalProperties": false
}
