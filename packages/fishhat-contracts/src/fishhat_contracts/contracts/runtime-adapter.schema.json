      "required": [
        "scope",
        "deployment"
      ],
      "additionalProperties": false
    },
    "activate": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "deployment": {
          "$ref": "adapter.schema.json#/$defs/Deployment"
        }
      },
      "required": [
        "scope",
        "deployment"
      ],
      "additionalProperties": false
    },
    "deactivate": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "deployment": {
          "$ref": "adapter.schema.json#/$defs/Deployment"
