{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/hook-result.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/hook-result/v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "unknown",
        "unsupported"
      ]
    },
    "effects": {
      "enum": [
        "none",
        "known",
        "unknown"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]+(?![\\s\\S])"
          },
          "passed": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "code",
          "passed",
          "summary"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f])[^/]+(?:/[^/]+)*(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10737418240
          },
          "digest": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "bytes",
          "digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "format",
    "request_id",
    "outcome",
    "effects",
    "checks",
    "artifacts"
  ],
  "additionalProperties": false
}
