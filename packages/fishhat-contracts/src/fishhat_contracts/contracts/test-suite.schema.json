{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/test-suite.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/domain-tests/v2"
    },
    "default_suite": {
      "const": "offline"
    },
    "runtime_lock_path": {
      "$ref": "common.schema.json#/$defs/RelativePath"
    },
    "runtime_lock_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "class": {
            "enum": [
              "offline",
              "observe",
              "mutate"
            ]
          },
          "required_role": {
            "$ref": "common.schema.json#/$defs/Role"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "cwd": {
            "$ref": "common.schema.json#/$defs/RelativePath"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "output_limit_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Entry"
            },
            "uniqueItems": true
          },
          "targets_required": {
            "type": "boolean"
          }
        },
        "required": [
          "class",
          "required_role",
          "argv",
          "cwd",
          "timeout_seconds",
          "output_limit_bytes",
          "required_inputs",
          "targets_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "default_suite",
    "runtime_lock_path",
    "runtime_lock_digest",
    "suites"
  ],
  "additionalProperties": false
}
