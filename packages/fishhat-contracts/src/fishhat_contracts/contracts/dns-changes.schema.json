{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/dns-changes.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/dns-change/v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "scope": {
      "$ref": "adapter.schema.json#/$defs/Scope"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before": {
            "anyOf": [
              {
                "$ref": "dns-intent.schema.json#/$defs/RRset"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "dns-intent.schema.json#/$defs/RRset"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "custodian": {
      "$ref": "common.schema.json#/$defs/Owner"
    }
  },
  "required": [
    "format",
    "id",
    "scope",
    "expected_generation",
    "changes",
    "custodian"
  ],
  "additionalProperties": false,
  "description": "Each change adds, deletes or replaces one RRset identity. Before and after cannot both be null, and non-null replacements retain the same name, class and type. RDATA member order is insignificant: a reorder-only before/after pair is a no-op and rejects. TTL policy and ordered content inside each member remain significant."
}
