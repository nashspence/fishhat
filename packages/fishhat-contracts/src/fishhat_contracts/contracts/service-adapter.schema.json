{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/service-adapter.schema.json",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "target": {
          "$ref": "adapter.schema.json#/$defs/SourceTargetBinding"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        }
      },
      "required": [
        "scope",
        "target",
        "intent"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "binding": {
          "$ref": "adapter.schema.json#/$defs/InstanceReference"
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit",
        "binding"
      ],
      "additionalProperties": false,
      "description": "List exact service observations within one approved scope. limit bounds returned services per response; a continuation advances within one stable observation snapshot and binds executor, scope and query. Changed snapshot identity requires explicit restart, never omission. Complete coverage has no continuation; incomplete pages advance their cursor. Different services may have different activity and enablement. The limit bounds the sum of returned top-level collection entries in services; nested fields within one entry are not separate records. Other scalar or object output fields are fixed-shape metadata and do not count toward this limit. A continuation is an opaque receiver-issued cursor bound to the exact approved executor, scope, query and one stable native observation snapshot. The receiver verifies those bindings on every continuation. Incomplete coverage requires a non-null cursor different from the request cursor; complete coverage has no continuation. Unknown coverage is not resumable and has no continuation; an unavailable or changed snapshot is explicitly unknown and requires a new scan with cursor null. Known records may accompany unknown coverage, but cannot establish complete absence. These per-page bounds do not limit total collection extent or prove native bounded work."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceObservation"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "services",
        "transition"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "plan"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "output": {
                  "properties": {
                    "transition": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "apply"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "services": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "output": {
                  "properties": {
                    "transition": {
                      "type": "null"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "coverage": {
                    "const": "incomplete"
                  }
                },
                "required": [
                  "coverage"
                ]
              },
              "then": {
                "properties": {
                  "continuation": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "continuation": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "description": "Observation page under the request limit and exact receiver-owned snapshot. Incomplete pages require an advancing continuation; complete and unknown coverage have no continuation. Unknown is not evidence of complete absence."
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies its original invocation attempt. Recovered output must satisfy the original method result and custody contract, using independently retained invocation bytes. Reconciliation supplies no authority to repeat or correct the mutation."
        }
      ]
    },
    "MutationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "apply"
            },
            "input": {
              "$ref": "#/$defs/apply"
            }
          },
          "required": [
            "contract",
            "method",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Intent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete"
          ]
        },
        "transition": {
          "enum": [
            "ensure",
            "reload",
            "restart"
          ]
        }
      },
      "required": [
        "enabled",
        "activity",
        "transition"
      ],
      "additionalProperties": false,
      "description": "Desired boot enablement and current activity are independent. ensure converges those states and permits a verified no-op. reload and restart are explicit events, require desired running activity, and cannot be proved merely by observing a running service. Unsupported reload is a no-effect rejection, never an implicit restart. A restart may use one native restart or an ordered separately confirmed stop/start compound.",
      "allOf": [
        {
          "if": {
            "properties": {
              "transition": {
                "enum": [
                  "reload",
                  "restart"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "activity": {
                "const": "running"
              }
            }
          }
        }
      ]
    },
    "ServiceObservation": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "adapter.schema.json#/$defs/SourceTargetBinding"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete",
            "unknown"
          ]
        }
      },
      "required": [
        "target",
        "enabled",
        "activity"
      ],
      "additionalProperties": false,
      "description": "One exact approved native service target. enabled reports observed boot policy independently of current activity; null means unknown policy. No aggregate activity substitutes for separate services in a shared scope. Native interpretation and accepted namespace identity stay with the selected executor."
    },
    "TransitionReceipt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "target": {
          "$ref": "adapter.schema.json#/$defs/SourceTargetBinding"
        },
        "transition": {
          "enum": [
            "reload",
            "restart"
          ]
        },
        "outcome": {
          "enum": [
            "succeeded",
            "unsupported",
            "failed",
            "unknown"
          ]
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "native",
                "stop-start"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "reload",
                  "restart",
                  "stop",
                  "start"
                ]
              },
              "receipt": {
                "$ref": "adapter.schema.json#/$defs/Artifact"
              }
            },
            "required": [
              "action",
              "receipt"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 2
        }
      },
      "required": [
        "attempt_id",
        "target",
        "transition",
        "outcome",
        "mode",
        "confirmations"
      ],
      "additionalProperties": false,
      "description": "Owner-retained native completion evidence for the exact event attempt, not current activity or a new dispatch token. Native reload/restart requires its own action confirmation. stop-start restart requires ordered stop and start confirmations; each receipt is immutable retained native evidence bound to this attempt and target. Unsupported events contain no confirmations and require a rejected terminal no-effect response. Unknown or partial effects retain prior confirmations and cannot authorize repetition."
    },
    "apply": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "target": {
          "$ref": "adapter.schema.json#/$defs/SourceTargetBinding"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        }
      },
      "required": [
        "scope",
        "target",
        "intent"
      ],
      "additionalProperties": false
    },
    "RetainedResult": {
      "description": "Complete durable evidence for one adapter.execute mutation. Retain the exact invocation and full direct or reconciliation response, including method, request digest, coverage, effect identity and typed output. Invocation owner, operation, executor and original request bytes must match the accepted Operation. Reconciliation reconstructs its request from this unchanged invocation and retains its original response method and request digest. Readers apply the same method-specific semantics as direct responses, including successful-output identity and custody; a succeeded Operation requires terminal known satisfied evidence. This record neither authenticates an owner nor grants native authority.",
      "type": "object",
      "properties": {
        "invocation": {
          "allOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Invocation"
            },
            {
              "properties": {
                "request": {
                  "$ref": "#/$defs/MutationRequest"
                }
              }
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "invocation",
        "response"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "plan"
        },
        "input": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "apply"
        },
        "input": {
          "$ref": "#/$defs/apply"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Service identity resolves to an owner-verified native target and mutation facet. Service lifecycle and runtime lifecycle cannot have independent controllers for the same target. A service executor enrolled under a runtime controller must act only through that controller's durable attempt, accepted binding, admission and recovery protections. Direct apply, reconcile or generic adapter dispatch cannot supply competing authority. Native target alias resolution and exclusion remain receiving-owner obligations. Mutation request objects are typed planning payloads. Native execution requires the owner-authored adapter Invocation with its exact attempt and accepted executor; a bare role request is not an alternate executable boundary. Every apply retains the exact independently approved SourceTargetBinding and complete typed intent. A requested boot-policy change changes the request identity even when activity remains running. Reconciliation must return the original intent result and event confirmations without executing it again."
}
