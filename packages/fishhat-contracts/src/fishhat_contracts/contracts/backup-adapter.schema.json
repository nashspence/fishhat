{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/backup-adapter.schema.json",
  "$defs": {
    "store": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "repository",
        "object",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "retrieve": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "repository",
        "object",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*(?![\\s\\S])"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "minItems": 0,
          "uniqueItems": true
