    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false,
      "description": "Each newly executed null-cursor invocation starts a fresh snapshot. If its first response was not accepted, a new null-cursor invocation may restart the scan. Replay of an already accepted page reuses the receiving owner's retained exact request and response; it does not ask a fresh adapter process to regenerate the old first page. Only a retained non-null cursor continues the previously selected native snapshot. The limit bounds the sum of returned top-level collection entries in objects; nested fields within one entry are not separate records. Other scalar or object output fields are fixed-shape metadata and do not count toward this limit. A continuation is an opaque receiver-issued cursor bound to the exact approved executor, scope, query and one stable native observation snapshot. The receiver verifies those bindings on every continuation. Incomplete coverage requires a non-null cursor different from the request cursor; complete coverage has no continuation. Unknown coverage is not resumable and has no continuation; an unavailable or changed snapshot is explicitly unknown and requires a new scan with cursor null. Known records may accompany unknown coverage, but cannot establish complete absence. These per-page bounds do not limit total collection extent or prove native bounded work."
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "invocation": {
          "$ref": "adapter.schema.json#/$defs/Invocation"
        }
      },
      "required": [
        "scope",
        "invocation"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original owner-retained invocation, including the original typed request, full accepted executor reference and attempt identity. Scope and role must agree with that closure. Recovered outputs obey the original method result contract. Current enrollment cannot retarget historical work; an unavailable or replaced executor leaves the result unresolved. Corrective mutation requires a separate reviewed invocation; reconciliation never dispatches or repeats the supplied mutation."
    },
    "Output": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/BackupObject"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "objects"
      ],
      "additionalProperties": false,
      "description": "A successful store retains one exact sealed object with available or explicitly deferred retrieval. Successful retrieval or verification requires that exact sealed object to be available; incomplete or missing data cannot establish either. A successful delete, including verified prior absence, retains the requested immutable object identity with retrieval missing. Deletion evidence is not a retrievable data copy."
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.backup"
            },
            "method": {
              "const": "store"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            },
            "problem": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "adapter.schema.json#/$defs/Problem"
                    },
                    {
                      "properties": {
                        "retry": {
                          "const": "none"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Adapter-domain explanation independent of native effect and material custody facts. Required null means no reported problem; it never implies success. Transport failure remains separate and this field never authorizes redispatch."
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect",
            "problem"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "effect": {
                    "properties": {
                      "task_state": {
                        "const": "terminal"
                      },
                      "effect_certainty": {
                        "const": "known"
                      },
                      "postcondition": {
                        "const": "satisfied"
                      }
                    },
                    "required": [
                      "task_state",
                      "effect_certainty",
                      "postcondition"
                    ]
                  }
                },
                "required": [
                  "effect"
                ]
              },
              "then": {
                "properties": {
                  "coverage": {
                    "const": "complete"
                  },
                  "continuation": {
                    "type": "null"
                  },
                  "output": {
                    "properties": {
                      "objects": {
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "properties": {
                            "completeness": {
                              "const": "sealed"
                            },
                            "retrieval": {
                              "enum": [
                                "available",
                                "deferred"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "Terminal satisfied effects require complete committed output custody under this method contract, including its exact requested identities. Native completion without required output remains unresolved; it is not successful completion. Pending, rejected and failed effects may return no output and retain their existing uncertainty and holds."
